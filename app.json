{
  "expo": {
    "name": "Mantra Alarm",
    "slug": "mantra-alarm",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mantraalarm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.michaelwatterson.mantraalarm",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mantra Alarm uses your microphone so you can set alarms with your voice.",
        "NSSpeechRecognitionUsageDescription": "Mantra Alarm transcribes what you say to create alarms and mantras.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.michaelwatterson.mantraalarm",
      "permissions": [
        "RECORD_AUDIO",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-av",
      [
        "expo-notifications",
        {
          "color": "#0b0b0f",
          "defaultChannel": "alarms",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-speech-recognition",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
