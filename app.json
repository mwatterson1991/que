{
  "expo": {
    "name": "Que",
    "slug": "que",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "que",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.michaelwatterson.que",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Que uses your microphone so you can set alarms with your voice.",
        "NSSpeechRecognitionUsageDescription": "Que uses speech recognition to understand your alarm requests.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.michaelwatterson.que",
      "permissions": [
        "RECORD_AUDIO",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-av",
      "expo-notifications",
      "expo-speech-recognition",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
