{
  "expo": {
    "name": "Que",
    "slug": "mantra-alarm",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mantraalarm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.michaelwatterson.que",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Que uses your microphone so you can set alarms with your voice.",
        "NSSpeechRecognitionUsageDescription": "Que transcribes what you say to create alarms and mantras.",
        "NSUserNotificationsUsageDescription": "Que uses notifications to fire your alarms at the right time.",
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.michaelwatterson.mantraalarm",
      "permissions": [
        "RECORD_AUDIO",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-av",
      "expo-notifications",
      "expo-speech-recognition",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d64998e2-be85-445a-8d37-bb29185735b1"
      }
    },
    "owner": "mwatterson1991"
  }
}
