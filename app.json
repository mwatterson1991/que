{
  "expo": {
    "name": "Morning Que",
    "slug": "mantra-alarm",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mantraalarm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.michaelwatterson.que",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Morning Que uses your microphone so you can set alarms with your voice.",
        "NSSpeechRecognitionUsageDescription": "Morning Que transcribes what you say to create alarms and mantras.",
        "NSUserNotificationsUsageDescription": "Morning Que uses notifications to fire your alarms at the right time.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b0f"
      },
      "package": "com.michaelwatterson.que",
      "permissions": [
        "RECORD_AUDIO",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#0b0b0f",
          "defaultChannel": "alarms",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d64998e2-be85-445a-8d37-bb29185735b1"
      }
    },
    "owner": "mwatterson1991"
  }
}
